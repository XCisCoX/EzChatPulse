{
  "name": "ezchatpulse",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted Telegram-style chat: WebSocket real-time, private + group chats, presence, persistent history, media sharing, TLS.",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "smoke": "node scripts/smoke.mjs",
    "seed": "npm run seed -w server",
    "loadtest": "npm run loadtest -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
